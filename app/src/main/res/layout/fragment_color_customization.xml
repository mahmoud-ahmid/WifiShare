<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="تخصيص الألوان"
            app:titleTextColor="?attr/colorOnSurface"
            app:navigationIcon="@drawable/ic_back" />

        <!-- ألوان الأزرار -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ألوان الأزرار" android:textSize="18sp" android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" android:layout_marginTop="16dp" />
        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:layout_marginTop="8dp">
            <LinearLayout
                android:id="@+id/layoutButtonColors"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="8dp" />
        </HorizontalScrollView>

        <!-- ألوان الخط -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ألوان الخط" android:textSize="18sp" android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" android:layout_marginTop="24dp" />
        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:layout_marginTop="8dp">
            <LinearLayout
                android:id="@+id/layoutTextColors"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="8dp" />
        </HorizontalScrollView>

        <!-- ألوان الخلفيات (الأوضاع) -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ألوان الخلفيات" android:textSize="18sp" android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" android:layout_marginTop="24dp" />
        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:layout_marginTop="8dp">
            <LinearLayout
                android:id="@+id/layoutBgModes"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="8dp" />
        </HorizontalScrollView>

        <!-- لوحة التحكم في الشفافية والغمقان -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="التحكم الدقيق (لون الأزرار)" android:textSize="18sp" android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" android:layout_marginTop="32dp" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <View
                android:id="@+id/viewPreview"
                android:layout_width="60dp" android:layout_height="60dp"
                android:background="@drawable/bg_circle" />

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="الشفافية (Opacity)" android:textColor="?attr/colorOnSurface" />
                <SeekBar android:id="@+id/seekOpacity"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="255" android:progress="255" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="الغمقان (Brightness)" android:textColor="?attr/colorOnSurface" />
                <SeekBar android:id="@+id/seekBrightness"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="100" android:progress="50" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyCustom"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="تطبيق اللون المخصص" />

    </LinearLayout>
</ScrollView>
